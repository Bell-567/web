# 服务端口
PORT=3000

# SQLite 数据库文件位置（默认 server/data/wanderlog.db）
# DATABASE_FILE=./data/wanderlog.db

# 允许跨域的前端来源，逗号分隔；填 * 表示允许所有来源
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# 查看联系表单提交记录所需的管理令牌（不设置则 GET /api/contact 返回 403）
# ADMIN_TOKEN=change-me
